# Local development only; these defaults must never be used in production.
POSTGRES_USER=dioffice
POSTGRES_PASSWORD=dioffice-dev-only
POSTGRES_HOST_PORT=15432
S3_HOST_PORT=9090

# Database
DATABASE_URL=postgres://dioffice:dioffice-dev-only@localhost:15432/dioffice?sslmode=disable

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Object storage (local S3Mock; test double only, not production storage)
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=dioffice
S3_ACCESS_KEY=foo
S3_SECRET_KEY=bar
S3_FORCE_PATH_STYLE=true

# GitHub App / integration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Agent gateway
AGENT_GATEWAY_URL=http://127.0.0.1:4100
AGENT_GATEWAY_INTERNAL_TOKEN=
# Configure only in the local gateway environment; never commit real paths.
# JSON map: {"<project-uuid>":"C:/absolute/path/to/project"}
AGENT_GATEWAY_PROJECT_FOLDERS={}

# OpenCode
OPENCODE_SERVER_URL=

# Future runtimes
OPENAI_API_KEY=
DEVIN_API_KEY=

# App
WEB_ORIGIN=http://127.0.0.1:5173
API_ADDRESS=127.0.0.1:8080
# Local HTTP only. Keep true behind HTTPS in any deployed environment.
COOKIE_SECURE=false
# Opt-in only for loopback development; API startup rejects public binds/origins.
DEV_AUTH_BYPASS=false
