# Same-origin API requests through Vite's local proxy.
VITE_API_BASE_URL=/
# Server-only Vite proxy target; never put credentials or API keys in VITE_* variables.
DIOFFICE_API_PROXY_TARGET=http://127.0.0.1:8080
# Shows the passwordless local-Owner button only in Vite development mode.
VITE_DEV_AUTH_BYPASS=false
